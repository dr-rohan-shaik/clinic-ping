# ClinicPing Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# Application Settings
# ====================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR

# ====================
# Database
# ====================
DATABASE_URL=postgresql://clinicping:password@localhost:5432/clinicping?schema=public&sslmode=disable

# Auth.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# ====================
# WhatsApp Cloud API (Meta)
# ====================
# Get these from https://developers.facebook.com/docs/whatsapp/cloud-api
WA_ACCESS_TOKEN=your-whatsapp-cloud-api-token
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_BUSINESS_ACCOUNT_ID=your-business-account-id
WA_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# n8n Internal API Secret (for HMAC verification)
N8N_WEBHOOK_SECRET=n8n-webhook-hmac-secret

# ====================
# n8n Configuration
# ====================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# ====================
# Chatwoot Configuration (if self-hosted)
# ====================
CHATWOOT_API_BASE_URL=http://localhost:3001
CHATWOOT_ACCESS_TOKEN=your-chatwoot-access-token

# ====================
# Caddy/HTTPS
# ====================
CADDY_ADDRESS=:80
CADDY_TLS_ADMIN_EMAIL=admin@clinicping.local

# ====================
# Security Settings
# ====================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session settings
SESSION_MAX_AGE=86400  # 24 hours
SESSION_HTTP_ONLY=true
SESSION_SECURE=false  # Set to true in production with HTTPS
SESSION_SAME_SITE=lax

# ====================
# Backup Settings
# ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM IST
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=s3://clinicping-backups/
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# ====================
# Email (for alerts)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ====================
# Feature Flags
# ====================
FEATURE_CASH_BOOK=true
FEATURE_RECALLS=true
FEATURE_BOT_HANDOFF=true